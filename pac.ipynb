   "source": [
    "# Read data from file1 and write/store it in another file!\n",
    "\n",
    "# We have to read data from file1\n",
    "\n",
    "file1=open(\"file1.txt\",\"r\")\n",
    "\n",
    "data=file1.read()\n",
    "\n",
    "file1.close()\n",
    "\n",
    "c=open(\"file2.txt\",\"w\")\n",
    "\n",
    "c.write(data)\n",
    "\n",
    "c.close()"
   ]
